    "faq": {
      "eyebrow": "QUESTIONS?",
      "headline": {
        "before": "Let's",
        "accent": "Clear",
        "after": "Things Up."
      },
      "description": "Before you schedule a consultation, here are the answers to the questions we hear most often.",
      "items": [
        {
          "id": "faq1",
          "question": "Do I have to pay to speak with an advisor?",
          "answer": "No. Your initial consultation is completely free and comes with no obligation.",
          "openByDefault": true
        },
        {
          "id": "faq2",
          "question": "Can you help me compare multiple plans?",
          "answer": "Yes. We help you review options from trusted carriers so you can make an informed decision.",
          "openByDefault": false
        },
        {
          "id": "faq3",
          "question": "Is my information secure?",
          "answer": "Yes. Your information is handled securely and only used to assist you with coverage options.",
          "openByDefault": false
        },
        {
          "id": "faq4",
          "question": "Can you help if I already have coverage?",
          "answer": "Absolutely. We can review your current coverage and help determine whether a better option may be available.",
          "openByDefault": false
        },
        {
          "id": "faq5",
          "question": "How long does the process take?",
          "answer": "Most consultations take 15-30 minutes depending on your needs.",
          "openByDefault": false
        },
        {
          "id": "faq6",
          "question": "What types of coverage can you help with?",
          "answer": "We can help with individual, family, prescription, hospital, specialist, and related health coverage options.",
          "openByDefault": false
        }
      ],
